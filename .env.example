# API Keys - Required

# Keyword Research & SERP (choose one)
DATAFORSEO_LOGIN=your_dataforseo_email
DATAFORSEO_PASSWORD=your_dataforseo_password
# OR
SERPER_API_KEY=your_serper_key

# AI API - llmsrelay (Unified LLM Gateway)
LLMSRELAY_API_KEY=your_llmsrelay_key
LLMSRELAY_BASE_URL=https://api.llmsrelay.com/v1

# Alternative AI APIs (optional)
OPENAI_API_KEY=your_openai_key
DEEPSEEK_API_KEY=your_deepseek_key
ANTHROPIC_API_KEY=your_anthropic_key

# Publishing API (optional)
WORDPRESS_API_URL=https://your-site.com/wp-json/wp/v2
WORDPRESS_API_TOKEN=your_token
# OR
CUSTOM_API_URL=https://your-api.com/articles
CUSTOM_API_KEY=your_key

# Optional
FIRECRAWL_API_KEY=your_firecrawl_key

# App Config
PORT=3000
JOBS_DIR=/tmp/jobs
